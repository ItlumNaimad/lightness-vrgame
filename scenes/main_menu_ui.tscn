theme_override_font_sizes/font_size = 18
text = "1. STEROWANIE VR:"

[node name="ControlsText" type="Label" parent="CenterContainer/PanelContainer/MarginContainer/GuidePanel/ScrollContainer/GuideContent"]
layout_mode = 2
theme_override_font_sizes/font_size = 15
text = "• Lewy kontroler: Snap Turn (obrót skokowy z dwutonowym whooshem i kompasem). Wciśnięcie gałki = Sprint (generuje hałas!).
• Prawy kontroler: Płynne poruszanie się w stronę wyciągniętego kontrolera.
• Przyciski menu: Dotknij fizycznie wirtualną dłonią lub skieruj wskaźnik i przytrzymaj (0.7s)."
autowrap_mode = 2

[node name="EnemiesHeader" type="Label" parent="CenterContainer/PanelContainer/MarginContainer/GuidePanel/ScrollContainer/GuideContent"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.2, 0.4, 1)
theme_override_font_sizes/font_size = 18
text = "2. ZAGROŻENIA I KONTRA:"

[node name="EnemiesText" type="Label" parent="CenterContainer/PanelContainer/MarginContainer/GuidePanel/ScrollContainer/GuideContent"]
layout_mode = 2
theme_override_font_sizes/font_size = 15
text = "• Balora: Patroluje mapę. Reaguje na BLISKOŚĆ (tempo pozytywki rośnie). Uciekaj sprintem!
• Foxy: Reaguje na HAŁAS kroków. Gdy zapadnie nagła cisza, po 2 sekundach szarżuje. Wystaw dłoń w stronę szarży by zablokować atak!
• Marionette: Szepty przy uchu z narastaniem. Zastygnij w bezruchu na 4s i odwróć głowę od dźwięku."
autowrap_mode = 2

